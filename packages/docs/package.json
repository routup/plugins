{
    "name": "@routup/plugins-docs",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "description": "Documentation site for routup plugins (plugins.routup.dev).",
    "scripts": {
        "dev": "vitepress dev src --temp .temp",
        "build": "npm run build:types && npm run build:site",
        "build:site": "vitepress build src --temp .temp",
        "build:types": "tsc --noEmit -p tsconfig.json",
        "preview": "vitepress preview src",
        "test": "vitest run --config ./test/vitest.config.ts"
    },
    "author": {
        "name": "Peter Placzek",
        "email": "contact@tada5hi.net",
        "url": "https://github.com/tada5hi"
    },
    "license": "MIT",
    "dependencies": {
        "@routup/docs-theme": "^0.1.0",
        "vitepress": "^1.6.4",
        "vue": "^3.5.45"
    },
    "devDependencies": {
        "@routup/assets": "^6.0.0",
        "@routup/basic": "^3.0.3",
        "@routup/body": "^4.1.0",
        "@routup/cookie": "^4.0.2",
        "@routup/cors": "^2.0.2",
        "@routup/decorators": "^5.3.1",
        "@routup/i18n": "^5.0.1",
        "@routup/logger": "^2.0.2",
        "@routup/prometheus": "^4.1.0",
        "@routup/query": "^4.0.3",
        "@routup/rate-limit": "^4.0.3",
        "@routup/rate-limit-redis": "^6.0.0",
        "@routup/swagger-ui": "^5.1.1",
        "routup": "^6.4.0"
    },
    "peerDependencies": {
        "routup": "^6.3.0"
    },
    "nx": {
        "targets": {
            "build": {
                "inputs": [
                    "default",
                    "^default",
                    "{workspaceRoot}/packages/*/src/**/*",
                    "{workspaceRoot}/packages/*/README.md"
                ]
            },
            "test": {
                "inputs": [
                    "default",
                    "^default",
                    "{workspaceRoot}/packages/*/src/**/*",
                    "{workspaceRoot}/packages/*/README.md"
                ]
            }
        }
    }
}
