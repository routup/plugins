{
    "name": "@routup/plugins-docs",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "description": "Documentation site for routup plugins (plugins.routup.dev).",
    "scripts": {
        "dev": "vitepress dev src --temp .temp",
        "build": "npm run build:types && npm run build:site",
        "build:site": "vitepress build src --temp .temp",
        "build:types": "tsc --noEmit -p tsconfig.json",
        "preview": "vitepress preview src",
        "test": "vitest run --config ./test/vitest.config.ts"
    },
    "author": {
        "name": "Peter Placzek",
        "email": "contact@tada5hi.net",
        "url": "https://github.com/tada5hi"
    },
    "license": "MIT",
    "dependencies": {
        "@routup/docs-theme": "^0.1.0",
        "vitepress": "^1.6.4",
        "vue": "^3.5.45"
    },
    "devDependencies": {
        "@routup/assets": "*",
        "@routup/basic": "*",
        "@routup/body": "*",
        "@routup/cookie": "*",
        "@routup/cors": "*",
        "@routup/decorators": "*",
        "@routup/i18n": "*",
        "@routup/logger": "*",
        "@routup/prometheus": "*",
        "@routup/query": "*",
        "@routup/rate-limit": "*",
        "@routup/rate-limit-redis": "*",
        "@routup/swagger-ui": "*",
        "@trapi/metadata": "^2.3.0",
        "@trapi/swagger": "^2.3.0",
        "ilingo": "^6.2.1",
        "prom-client": "^15.1.3",
        "redis-extension": "^3.0.0",
        "routup": "^6.4.0"
    },
    "peerDependencies": {
        "routup": "^6.3.0"
    },
    "nx": {
        "targets": {
            "build": {
                "inputs": [
                    "default",
                    "^default",
                    "{workspaceRoot}/packages/*/src/**/*",
                    "{workspaceRoot}/packages/*/README.md"
                ]
            },
            "test": {
                "inputs": [
                    "default",
                    "^default",
                    "{workspaceRoot}/packages/*/src/**/*",
                    "{workspaceRoot}/packages/*/README.md",
                    "{workspaceRoot}/README.md"
                ],
                "dependsOn": []
            }
        }
    }
}
